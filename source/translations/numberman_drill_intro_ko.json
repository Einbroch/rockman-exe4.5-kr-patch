  "protected_policy": "All flags, command arguments, keyWait/clearMsg, vertical option widths11/13, navigation, source select targets/default/disableB unchanged. Preserve newline counts and numerals0/40. Other14 scripts unchanged. Lecture final all-targets-continue retained, not changed to an invented repeat branch.",
  "wordings": [
    {
      "id": "numberman.drill.0.0",
      "translation": "후후후\n가동했군요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.0.1",
      "translation": "이건\n카운트봄이 내장된\n지옥의 계산 훈련・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.0.2",
      "translation": "이 특훈으로 당신의\n편차치도 쑥쑥\n오를 게 틀림없어요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.0.3",
      "translation": "특훈 시작\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.0.4",
      "translation": "설명 듣기\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.0",
      "translation": "훈련 이용 방법을\n설명해 드릴게요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.1",
      "translation": "내용은 간단해요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.2",
      "translation": "카운트봄의 시간이\n0이 되기 전에",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.3",
      "translation": "제가 든 계산식의\n빈칸에 들어갈\n답을",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.4",
      "translation": "아래 선택지에서\n골라서\n식을 완성해 주세요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.5",
      "translation": "만약 틀리면・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.6",
      "translation": "벌로\n같은 문제를 다시\n풀어야 해요!",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.7",
      "translation": "카운트봄의 시간은\n40초로 설정했어요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.8",
      "translation": "40초 안에\n전부 맞히지 못하면・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.9",
      "translation": "제가\n폭발에 휘말려요!",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.10",
      "translation": "네, 네\n몸을 걸고 있어요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.11",
      "translation": "마지막으로\n질문 있나요?",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.12",
      "translation": "네! 없는 것 같으니\n이것으로 설명을\n마치겠습니다",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.13",
      "translation": "이번엔 훈련 시작\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.14",
      "translation": "다시 설명 듣기\n",
      "state": "needs_review"
    }
  ],
  "units": [
    {
      "id": "715064:0:0",
      "source": "ふっふっふっ\nきどう しましたね",
      "wording_id": "numberman.drill.0.0"
    },
    {
      "id": "715064:0:1",
      "source": "この\nカウントボムを ないぞうした\nじごくの けいさんドリル・・・",
      "wording_id": "numberman.drill.0.1"
    },
    {
      "id": "715064:0:2",
      "source": "このとっくんで あなたの\nへんさちも グーンと\nアップ まちがいなしです",
      "wording_id": "numberman.drill.0.2"
    },
    {
      "id": "715064:0:3",
      "source": "とっくんドリルきどう\n",
      "wording_id": "numberman.drill.0.3"
    },
    {
      "id": "715064:0:4",
      "source": "レクチャーをきく\n",
      "wording_id": "numberman.drill.0.4"
    },
    {
      "id": "715064:1:0",
      "source": "ドリルの しようほうほうを\nレクチャーしましょう",
      "wording_id": "numberman.drill.1.0"
    },
    {
      "id": "715064:1:1",
      "source": "ないようは かんたんです",
      "wording_id": "numberman.drill.1.1"
    },
    {
      "id": "715064:1:2",
      "source": "カウントボムのじかんが\n0になるまえに",
      "wording_id": "numberman.drill.1.2"
    },
    {
      "id": "715064:1:3",
      "source": "わたしのもつ けいさんしきの\nあいている ばしょに\nはいる こたえを",
      "wording_id": "numberman.drill.1.3"
    },
    {
      "id": "715064:1:4",
      "source": "したのせんたくしの中から\nえらんで\nしきを かんせいさせてください",
      "wording_id": "numberman.drill.1.4"
    },
    {
      "id": "715064:1:5",
      "source": "もし まちがえたら・・・",
      "wording_id": "numberman.drill.1.5"
    },
    {
      "id": "715064:1:6",
      "source": "おしおきとして\nもういちどおなじもんだいを\nやってもらいます!",
      "wording_id": "numberman.drill.1.6"
    },
    {
      "id": "715064:1:7",
      "source": "カウントボムの じかんは\n40びょうに せっていしました",
      "wording_id": "numberman.drill.1.7"
    },
    {
      "id": "715064:1:8",
      "source": "40びょういないに\nぜんもん せいかいしないと・・",
      "wording_id": "numberman.drill.1.8"
    },
    {
      "id": "715064:1:9",
      "source": "わたしが\nばくはつに まきこまれます!",
      "wording_id": "numberman.drill.1.9"
    },
    {
      "id": "715064:1:10",
      "source": "ええ ええ\nからだ はってますよ",
      "wording_id": "numberman.drill.1.10"
    },
    {
      "id": "715064:1:11",
      "source": "さいごに なにか\nしつもんは ありますか?",
      "wording_id": "numberman.drill.1.11"
    },
    {
      "id": "715064:1:12",
      "source": "ハイ! ないようなので\nこれで レクチャーを\nしゅうりょうします",
      "wording_id": "numberman.drill.1.12"
    },
    {
      "id": "715064:1:13",
      "source": "こんどこそ ドリルきどう\n",
      "wording_id": "numberman.drill.1.13"
    },
    {
      "id": "715064:1:14",
      "source": "また レクチャーをきく\n",
      "wording_id": "numberman.drill.1.14"
    }
  ]
}
