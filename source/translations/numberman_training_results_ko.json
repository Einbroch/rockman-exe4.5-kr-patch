  "wordings": [
    {
      "id": "numberman.training.10.0",
      "translation": "넷 배틀은\n계산이 생명!",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.10.1",
      "translation": "계산을 못하는\n넷 배틀러는\n살아남지 못해요!",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.10.2",
      "translation": "자, 그런 꼴을\n당하지 않도록,\n특훈을 해 봐요!",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.10.3",
      "translation": "괜찮죠?",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.10.4",
      "translation": "응  ",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.10.5",
      "translation": "싫어!",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.11.0",
      "translation": "그런가요・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.11.1",
      "translation": "나중에 어찌 되든\n저는 몰라요・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.20.0",
      "translation": "저, 저기・・・\n말씀드리자면,",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.20.1",
      "translation": "플러그인은,\n조금 더",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.20.2",
      "translation": "훈련한 뒤에\n하지 않겠어요?",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.20.3",
      "translation": "지금 상태로는,\n제가 불안해서・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.20.4",
      "translation": "특훈・・・\n해 봐요・・・ 네?",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.20.6",
      "translation": "싫은데",
      "state": "needs_review"
    },
    {
      "id": "numberman.training.21.0",
      "translation": "후회하실 거예요・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.result.poor.0",
      "translation": "、\n이런 계산도\n못하시다니・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.result.poor.1",
      "translation": "앞날이 걱정이에요",
      "state": "needs_review"
    },
    {
      "id": "numberman.result.good.0",
      "translation": "오케이!\n계산이 멋졌어요!",
      "state": "needs_review"
    },
    {
