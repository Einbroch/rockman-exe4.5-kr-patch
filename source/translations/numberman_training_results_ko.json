  "units": [
    {
      "id": "687910:10:0",
      "source": "ネットバトルは\nけいさんが イノチ!",
      "wording_id": "numberman.training.10.0"
    },
    {
      "id": "687910:10:1",
      "source": "けいさん できない\nネットバトラーは\nのたれじぬのです!",
      "wording_id": "numberman.training.10.1"
    },
    {
      "id": "687910:10:2",
      "source": "さぁ、そんなコトに\nならないよう、\nとっくんを しましょう!",
      "wording_id": "numberman.training.10.2"
    },
    {
      "id": "687910:10:3",
      "source": "いいですね?",
      "wording_id": "numberman.training.10.3"
    },
    {
      "id": "687910:10:4",
      "source": "うん  ",
      "wording_id": "numberman.training.10.4"
    },
    {
      "id": "687910:10:5",
      "source": "やだ!",
      "wording_id": "numberman.training.10.5"
    },
    {
      "id": "687910:11:0",
      "source": "そうですか・・・",
      "wording_id": "numberman.training.11.0"
    },
    {
      "id": "687910:11:1",
      "source": "アトで どうなっても\nしりませんよ・・・",
      "wording_id": "numberman.training.11.1"
    },
    {
      "id": "687910:20:0",
      "source": "あ、あのー・・・\nおコトバですけど、",
      "wording_id": "numberman.training.20.0"
    },
    {
      "id": "687910:20:1",
      "source": "プラグインするのは、\nもうすこし",
      "wording_id": "numberman.training.20.1"
    },
    {
      "id": "687910:20:2",
      "source": "きたえてからに\nしませんか?",
      "wording_id": "numberman.training.20.2"
    },
    {
      "id": "687910:20:3",
      "source": "今のままじゃ、\nワタシ ふあんで・・・",
      "wording_id": "numberman.training.20.3"
    },
    {
      "id": "687910:20:4",
      "source": "とっくん・・・\nしましょうよ・・・ね?",
      "wording_id": "numberman.training.20.4"
    },
    {
      "id": "687910:20:5",
      "source": "うん  ",
      "wording_id": "numberman.training.10.4"
    },
    {
      "id": "687910:20:6",
      "source": "やだな",
      "wording_id": "numberman.training.20.6"
    },
    {
      "id": "687910:21:0",
      "source": "こうかいしますよ・・・",
      "wording_id": "numberman.training.21.0"
    },
    {
      "id": "687910:13:0",
      "source": "、\nこんな けいさんも\nできないとは・・・",
      "wording_id": "numberman.result.poor.0"
    },
    {
      "id": "687910:13:1",
      "source": "さきが おもいやられます",
      "wording_id": "numberman.result.poor.1"
    },
    {
      "id": "687910:14:0",
      "source": "オッケー!\nナイスけいさん でした!",
      "wording_id": "numberman.result.good.0"
    },
    {
      "id": "687910:14:1",
      "source": "のうないの しわが\nふえましたよ!!",
      "wording_id": "numberman.result.good.1"
    },
    {
      "id": "687910:14:2",
      "source": "なんだか、せいめい力が\nあふれてきました!",
      "wording_id": "numberman.result.good.2"
    },
    {
      "id": "687910:15:0",
      "source": "まぁ、じょうできですね\nごほうびと いっては\nなんですが、",
      "wording_id": "numberman.result.reward.0"
    },
    {
      "id": "687910:15:1",
      "source": "かるくプレゼントを・・・",
      "wording_id": "numberman.result.reward.1"
    },
    {
      "id": "687910:17:0",
      "source": "まずまずの できですね\nごほうびと いっては\nなんですが、",
      "wording_id": "numberman.result.middling.0"
    },
    {
      "id": "687910:17:1",
      "source": "かるくプレゼントを・・・",
      "wording_id": "numberman.result.reward.1"
    },
    {
