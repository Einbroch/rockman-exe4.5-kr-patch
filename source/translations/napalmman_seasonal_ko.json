  "units": [
    {
      "id": "6C004C:1:0",
      "source": "ドカーーーーン!",
      "translation": "콰아아아앙!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:1:1",
      "source": "あけましてぇ\nおめでとうだオラァ!",
      "translation": "새해 복 많이\n받아라,으랴아!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:1:2",
      "source": "今年も ぶっぱなして\nいくぜ!",
      "translation": "올해도 마구 쏴\n갈겨 주겠어!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:1:3",
      "source": "よろしくたのむぜ!",
      "translation": "잘 부탁한다!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:2:0",
      "source": "今日は せつぶんだ!!\nマメまきするぜ!!",
      "translation": "오늘은 절분이다!!\n콩을 뿌리겠어!!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:2:1",
      "source": "オレの マメまきは、\nちょっと、カゲキだぜ!",
      "translation": "내 콩 뿌리기는,\n좀 과격하다고!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:2:2",
      "source": "オニはーそと!\nズガーン!!",
      "translation": "도깨비는 밖으로!\n콰앙!!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:2:3",
      "source": "ふくはーうち!\nボガーン!!",
      "translation": "복은 안으로!\n쾅쾅!!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:2:4",
      "source": "スッキリしたぜぇ!",
      "translation": "속이 후련하군!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:3:0",
      "source": "今日は、\nバレンタインだな!",
      "translation": "오늘은,\n발렌타인데이군!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:3:1",
      "source": "今日は オトコが\nねらいうち\nされる日だな!",
      "translation": "오늘은 남자가\n집중 공략을\n당하는 날이군!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:3:2",
      "source": "どうだ、ターゲットに\nなるキブンは?",
      "translation": "어때,표적이\n되는 기분은?",
      "state": "needs_review"
    },
    {
      "id": "6C004C:4:0",
      "source": "今日は、\nバレンタインだな!",
      "translation": "오늘은,\n발렌타인데이군!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:4:1",
      "source": "おまえの\nチョコバズーカで",
      "translation": "네\n초콜릿 바주카로",
      "state": "needs_review"
    },
    {
      "id": "6C004C:4:2",
      "source": "ダレを ねらいうちに\nするんだ?",
      "translation": "누구를 집중\n공략할 거냐?",
      "state": "needs_review"
    },
    {
      "id": "6C004C:5:0",
      "source": "今日は ひなまつりか\nオンナのまつり\nらしいが、",
      "translation": "오늘은 히나마쓰리군\n여자들의 축제\n라지만,",
      "state": "needs_review"
    },
    {
      "id": "6C004C:5:1",
      "source": "どんなまつりも\nさわがなくちゃぁ\nソンってモンだぜ!!",
      "translation": "어떤 축제든\n떠들썩하게 즐겨야\n손해 안 본다고!!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:6:0",
      "source": "今日は こどもの日だ!",
      "translation": "오늘은 어린이날이다!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:6:1",
      "source": "あちこちに\nヨロイカブトが\nかざってあってよぉ、",
      "translation": "여기저기에\n갑옷과 투구가\n장식돼 있어서,",
      "state": "needs_review"
    },
    {
      "id": "6C004C:6:2",
      "source": "なんか オトコゴコロを\nくすぐられる日だぜ!",
      "translation": "왠지 남자의 마음을\n설레게 하는 날이야!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:7:0",
      "source": "今日は 7月7日、\nたなばた だぜ!",
      "translation": "오늘은 7월7일,\n칠석이다!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:7:1",
      "source": "よぞらの あまのがわの\nホシボシを ぜんぶ\nうちおとしてやるぜ!",
      "translation": "밤하늘 은하수의\n별들을 모조리\n쏴 떨어뜨리겠어!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:8:0",
      "source": "今日は、\nクリスマスイヴだ!",
      "translation": "오늘은,\n크리스마스이브다!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:8:1",
      "source": "オレは こんな\nチャラチャラした\nまつりなんかな・・・",
      "translation": "난 이렇게\n요란하게 꾸민\n축제 따윈・・・",
      "state": "needs_review"
    },
    {
      "id": "6C004C:8:2",
      "source": "大すきだぜ!!",
      "translation": "정말 좋아한다고!!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:9:0",
      "source": "今日は、\nクリスマスだ!!",
      "translation": "오늘은,\n크리스마스다!!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:9:1",
      "source": "クリスマスって\nいっても、",
      "translation": "크리스마스라고\n해도,",
      "state": "needs_review"
    },
    {
      "id": "6C004C:9:2",
      "source": "もう そろそろ\n正月キブンに\nなってるんじゃねぇか?",
      "translation": "벌써 슬슬\n새해 기분이\n들고 있지 않냐?",
      "state": "needs_review"
    },
    {
      "id": "6C004C:10:0",
      "source": "今日は、大みそかだな!",
      "translation": "오늘은 섣달그믐이군!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:10:1",
      "source": "じょやのカネの かわりに\n108ぱつの\nナパームだんを",
      "translation": "제야의 종 대신\n108발의\n네이팜탄을",
      "state": "needs_review"
    },
    {
      "id": "6C004C:10:2",
      "source": "うちならしてやろうか?",
      "translation": "쏴 울려 줄까?",
      "state": "needs_review"
    },
    {
      "id": "6C004C:11:0",
      "source": "今日は おまえの\nたんじょう日だったな!",
      "translation": "오늘이 네\n생일이었지!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:11:1",
      "source": "ようし、さっそく\nたんじょう日 きねん\nネットバトルだ!!",
      "translation": "좋아,당장\n생일 기념\n넷 배틀이다!!",
      "state": "needs_review"
    },
    {
      "id": "6C004C:12:0",
      "source": "今日は 学校の\nそうりつきねん日じゃあ\nなかったか?",
      "translation": "오늘은 학교\n개교 기념일이\n아니었나?",
      "state": "needs_review"
    },
    {
      "id": "6C004C:17:0",
      "source": "今日は",
      "translation": "오늘은",
      "state": "needs_review"
    },
