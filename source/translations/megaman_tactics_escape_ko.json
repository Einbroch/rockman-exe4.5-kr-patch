  "units": [
    {
      "id": "76C944:0:0",
      "source": "どのてきを\nねらう?",
      "translation": "어느 적을\n노릴까?",
      "state": "needs_review"
    },
    {
      "id": "76C944:1:0",
      "source": "てきとの\nまあいは?",
      "translation": "적과의\n거리는?",
      "state": "needs_review"
    },
    {
      "id": "76C944:2:0",
      "source": "ここは、にげた方がいいかな?\n",
      "translation": "여긴 도망칠까?\n",
      "state": "needs_review"
    },
    {
      "id": "76C944:2:1",
      "source": "はい  ",
      "translation": "예  ",
      "state": "needs_review"
    },
    {
      "id": "76C944:2:2",
      "source": "いいえ",
      "translation": "아니요",
      "state": "needs_review"
    },
    {
      "id": "76C944:3:3",
      "source": "よし!\nなんとかにげきれたよ!",
      "translation": "좋아!\n겨우 도망쳤어!",
      "state": "needs_review"
    },
    {
      "id": "76C944:4:3",
      "source": "ダメだ!\nにげきれない・・・!",
      "translation": "안 돼!\n도망칠 수 없어・・・!",
      "state": "needs_review"
    },
    {
      "id": "76C944:5:0",
      "source": "ここはにげてるばあいじゃ\nないよ!",
      "translation": "여긴 도망칠 때가\n아니야!",
      "state": "needs_review"
    }
