  "wordings": [
    {
      "id": "numberman.drill.0.0",
      "translation": "후후후\n가동했군요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.0.1",
      "translation": "이건\n카운트봄이 내장된\n지옥의 계산 훈련・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.0.2",
      "translation": "이 특훈으로 당신의\n편차치도 쑥쑥\n오를 게 틀림없어요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.0.3",
      "translation": "특훈 시작\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.0.4",
      "translation": "설명 듣기\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.0",
      "translation": "훈련 이용 방법을\n설명해 드릴게요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.1",
      "translation": "내용은 간단해요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.2",
      "translation": "카운트봄의 시간이\n0이 되기 전에",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.3",
      "translation": "제가 든 계산식의\n빈칸에 들어갈\n답을",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.4",
      "translation": "아래 선택지에서\n골라서\n식을 완성해 주세요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.5",
      "translation": "만약 틀리면・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.6",
      "translation": "벌로\n같은 문제를 다시\n풀어야 해요!",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.7",
      "translation": "카운트봄의 시간은\n40초로 설정했어요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.8",
      "translation": "40초 안에\n전부 맞히지 못하면・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.9",
      "translation": "제가\n폭발에 휘말려요!",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.10",
      "translation": "네, 네\n몸을 걸고 있어요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.11",
      "translation": "마지막으로\n질문 있나요?",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.12",
      "translation": "네! 없는 것 같으니\n이것으로 설명을\n마치겠습니다",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.13",
      "translation": "이번엔 훈련 시작\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.1.14",
      "translation": "다시 설명 듣기\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.2.0",
      "translation": "훈련\n・・・\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.3.0",
      "translation": "쉬워요\n정말로",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.4.0",
      "translation": "음~",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.5.0",
      "translation": "더\n힘내요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.6.0",
      "translation": "다음\n문제는",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.7.0",
      "translation": "한 번 더",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.8.0",
      "translation": "빠, 빨리\n서둘러요!\n서둘러요!",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.9.0",
      "translation": "시,\n시간이\n없어요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.10.0",
      "translation": "으아아\n아아아아",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.11.0",
      "translation": "훌륭해요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.12.0",
      "translation": "힘내\n주세요!\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.14.0",
      "translation": "이 식으로\n해도\n될까요?",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.13.0",
      "translation": "원하는 레벨을 고르세요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.13.1",
      "translation": "레벨1",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.13.2",
      "translation": "레벨2\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.13.3",
      "translation": "레벨3",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.13.4",
      "translation": "레벨4\n",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.15.1",
      "translation": "이건\n카운트봄이 내장된\n학력 조사 훈련・・・",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.15.2",
      "translation": "각오해 주세요\n이 훈련으로 당신의\n편차치가 드러나요",
      "state": "needs_review"
    },
    {
      "id": "numberman.drill.15.3",
      "translation": "훈련 시작\n",
      "state": "needs_review"
    }
