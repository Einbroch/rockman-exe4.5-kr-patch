  "units": [
    {
      "id": "715064:0:0",
      "source": "ふっふっふっ\nきどう しましたね",
      "wording_id": "numberman.drill.0.0"
    },
    {
      "id": "715064:0:1",
      "source": "この\nカウントボムを ないぞうした\nじごくの けいさんドリル・・・",
      "wording_id": "numberman.drill.0.1"
    },
    {
      "id": "715064:0:2",
      "source": "このとっくんで あなたの\nへんさちも グーンと\nアップ まちがいなしです",
      "wording_id": "numberman.drill.0.2"
    },
    {
      "id": "715064:0:3",
      "source": "とっくんドリルきどう\n",
      "wording_id": "numberman.drill.0.3"
    },
    {
      "id": "715064:0:4",
      "source": "レクチャーをきく\n",
      "wording_id": "numberman.drill.0.4"
    },
    {
      "id": "715064:1:0",
      "source": "ドリルの しようほうほうを\nレクチャーしましょう",
      "wording_id": "numberman.drill.1.0"
    },
    {
      "id": "715064:1:1",
      "source": "ないようは かんたんです",
      "wording_id": "numberman.drill.1.1"
    },
    {
      "id": "715064:1:2",
      "source": "カウントボムのじかんが\n0になるまえに",
      "wording_id": "numberman.drill.1.2"
    },
    {
      "id": "715064:1:3",
      "source": "わたしのもつ けいさんしきの\nあいている ばしょに\nはいる こたえを",
      "wording_id": "numberman.drill.1.3"
    },
    {
      "id": "715064:1:4",
      "source": "したのせんたくしの中から\nえらんで\nしきを かんせいさせてください",
      "wording_id": "numberman.drill.1.4"
    },
    {
      "id": "715064:1:5",
      "source": "もし まちがえたら・・・",
      "wording_id": "numberman.drill.1.5"
    },
    {
      "id": "715064:1:6",
      "source": "おしおきとして\nもういちどおなじもんだいを\nやってもらいます!",
      "wording_id": "numberman.drill.1.6"
    },
    {
      "id": "715064:1:7",
      "source": "カウントボムの じかんは\n40びょうに せっていしました",
      "wording_id": "numberman.drill.1.7"
    },
    {
      "id": "715064:1:8",
      "source": "40びょういないに\nぜんもん せいかいしないと・・",
      "wording_id": "numberman.drill.1.8"
    },
    {
      "id": "715064:1:9",
      "source": "わたしが\nばくはつに まきこまれます!",
      "wording_id": "numberman.drill.1.9"
    },
    {
      "id": "715064:1:10",
      "source": "ええ ええ\nからだ はってますよ",
      "wording_id": "numberman.drill.1.10"
    },
    {
      "id": "715064:1:11",
      "source": "さいごに なにか\nしつもんは ありますか?",
      "wording_id": "numberman.drill.1.11"
    },
    {
      "id": "715064:1:12",
      "source": "ハイ! ないようなので\nこれで レクチャーを\nしゅうりょうします",
      "wording_id": "numberman.drill.1.12"
    },
    {
      "id": "715064:1:13",
      "source": "こんどこそ ドリルきどう\n",
      "wording_id": "numberman.drill.1.13"
    },
    {
      "id": "715064:1:14",
      "source": "また レクチャーをきく\n",
      "wording_id": "numberman.drill.1.14"
    },
    {
      "id": "715064:2:0",
      "source": "ドリル\n・・・\n",
      "wording_id": "numberman.drill.2.0"
    },
    {
      "id": "715064:3:0",
      "source": "かんたん\nですよ",
      "wording_id": "numberman.drill.3.0"
    },
    {
      "id": "715064:4:0",
      "source": "う~ん",
      "wording_id": "numberman.drill.4.0"
    },
    {
      "id": "715064:5:0",
      "source": "もっと\nがんばって",
      "wording_id": "numberman.drill.5.0"
    },
    {
      "id": "715064:6:0",
      "source": "つぎの\nもんだいは",
      "wording_id": "numberman.drill.6.0"
    },
    {
      "id": "715064:7:0",
      "source": "もういちど",
      "wording_id": "numberman.drill.7.0"
    },
    {
      "id": "715064:8:0",
      "source": "はっはやく\nいそいで!\nいそいで!",
      "wording_id": "numberman.drill.8.0"
    },
    {
      "id": "715064:9:0",
      "source": "じっ\nじかんが\nないですよ",
      "wording_id": "numberman.drill.9.0"
    },
    {
      "id": "715064:10:0",
      "source": "ひぇぇぇぇ\nぇぇぇぇぇ",
      "wording_id": "numberman.drill.10.0"
    },
    {
      "id": "715064:11:0",
      "source": "すばらしい",
      "wording_id": "numberman.drill.11.0"
    },
    {
      "id": "715064:12:0",
      "source": "がんばって\nください!\n",
      "wording_id": "numberman.drill.12.0"
    },
    {
      "id": "715064:14:0",
      "source": "このしきで\nよろしい\nですか?",
      "wording_id": "numberman.drill.14.0"
    },
    {
      "id": "715064:13:0",
      "source": "すきなレベルを えらんでね",
      "wording_id": "numberman.drill.13.0"
    },
    {
      "id": "715064:13:1",
      "source": "レベル1",
      "wording_id": "numberman.drill.13.1"
    },
    {
      "id": "715064:13:2",
      "source": "レベル2\n",
      "wording_id": "numberman.drill.13.2"
    },
    {
      "id": "715064:13:3",
      "source": "レベル3",
      "wording_id": "numberman.drill.13.3"
    },
    {
      "id": "715064:13:4",
      "source": "レベル4\n",
      "wording_id": "numberman.drill.13.4"
    },
    {
      "id": "715064:15:0",
      "source": "ふっふっふっ\nきどう しましたね",
      "wording_id": "numberman.drill.0.0"
    },
    {
      "id": "715064:15:1",
      "source": "この\nカウントボムを ないぞうした\nがくりょくちょうさドリル・・・",
      "wording_id": "numberman.drill.15.1"
    },
    {
      "id": "715064:15:2",
      "source": "かくごしてください\nこのドリルで あなたの\nへんさちが まるわかりですよ",
      "wording_id": "numberman.drill.15.2"
    },
    {
      "id": "715064:15:3",
      "source": "ドリルきどう\n",
      "wording_id": "numberman.drill.15.3"
    },
    {
      "id": "715064:15:4",
      "source": "レクチャーをきく\n",
      "wording_id": "numberman.drill.0.4"
    }
  ],
