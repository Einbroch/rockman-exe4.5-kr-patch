    {"id": "6DA21C:2:0", "source": "今、セーブしてるから、\nでんげんを きらないでね", "wording_id": "save.writing"},
    {"id": "6DA21C:2:1", "source": "セーブに\nしっぱいしたみたい・・・", "wording_id": "save.failed"},
