    {"id": "6DA21C:2:4", "source": "いいえ", "wording_id": "save.no"},
    {"id": "6DA21C:3:0", "source": "よし!\nセーブおわったよ!", "wording_id": "save.success"},
    {"id": "6DA21C:4:0", "source": "データが不正に\nかきかえられていて\nセーブできないよ", "wording_id": "save.invalid"},
