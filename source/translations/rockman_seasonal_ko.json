      "id": "65E438:18:1",
      "source": "」",
      "translation": "」",
      "state": "needs_review"
    },
    {
      "id": "65E438:19:0",
      "source": "だよ!",
      "translation": "이야!",
      "state": "needs_review"
    }
  ]
